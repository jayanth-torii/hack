# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# ---- Mock mode ----
# When true, the AI provider, web-search grounding, HEAD-check freshness verification,
# and Google Calendar client all return deterministic fake data instead of calling
# real external services. The whole product works end-to-end with MOCK_MODE=true and
# no external API keys at all. Flip to false once real keys below are filled in.
MOCK_MODE=true

# ---- Mongo ----
MONGO_URI=mongodb://mongo:27017/pathmind

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- AI provider ----
# "anthropic" is the default/primary provider. "openai" is stubbed behind the same
# AIProvider interface for later use. Ignored while MOCK_MODE=true.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=

# ---- Web search grounding (used for freshness + "best resources" discovery) ----
# Any Tavily/Serper/Bing-style search API works; webSearch.ts wraps it behind one
# function. Ignored while MOCK_MODE=true.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# ---- Google Calendar OAuth ----
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console with the
# Calendar API enabled and this redirect URI registered. Ignored while MOCK_MODE=true
# — the .ics download fallback always works regardless of these being set.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---- Rate limiting ----
GENERATE_RATE_LIMIT_MAX=5
GENERATE_RATE_LIMIT_WINDOW_MS=3600000

# ---- Freshness worker ----
FRESHNESS_CRON_SCHEDULE=0 3 * * *
FRESHNESS_STALE_DAYS=7
